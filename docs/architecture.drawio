        <mxCell id="lb1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1120.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt1" value="Analyst loads the Dashboard SPA (CloudFront → S3 via OAI, HTTPS) and signs in at the Cognito Hosted UI (OAuth code flow, TOTP MFA); the SPA exchanges the code for an ID token." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1118.0" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1146.5" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt2" value="The dashboard sends POST /pricing-cycles to API Gateway with the Cognito JWT (ID token); the authorizer validates it and the route invokes rdp-api-pricing-cycles." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1144.5" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1173.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt3" value="rdp-api-pricing-cycles stores the cycle (INITIATED) in PricingCycles, invokes itself asynchronously (Lambda invoke, Event) and returns 202." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1171.0" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1199.5" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt4" value="The async run calls the Orchestrator agent with InvokeAgentRuntime (SigV4) and waits for the result, writing agent statuses to PricingCycles." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1197.5" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1226.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt5" value="The orchestrator runs Competitive Intelligence, Demand Forecasting and Market Intelligence in parallel, then Strategy Synthesis; they call MCP tools through the gateway (→ rdp-mcp-* Lambdas), Bedrock and Memory." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1224.0" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1252.5" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt6" value="rdp-api-pricing-cycles scans Products, writes PricingScenarios, auto-approves LOW-risk &quot;Recommended&quot; scenarios (scenario status, Products.currentPrice) and marks the cycle COMPLETE." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1250.5" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1279.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt7" value="The dashboard polls GET /pricing-cycles/{id} and /{id}/scenarios (rdp-api-pricing-cycles) and GET /agents/status (rdp-api-agents-status reads PricingCycles)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1277.0" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1305.5" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt8" value="The analyst approves: POST /approvals → rdp-api-approvals writes Approvals, the scenario status and Products.currentPrice; Implementation Monitoring only if IMPLEMENTATION_MONITORING_AGENT_ARN is set (not set by CDK)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="262" y="1303.5" width="605" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lb9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="233" y="1332.0" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lt9" value="Shoppers load the Storefront SPA (CloudFront → S3); rdp-api-products serves GET /products and GET /products/{id} (HTTPS, no auth) from the Products table." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
